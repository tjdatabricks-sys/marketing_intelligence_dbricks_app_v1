{
  "name": "marketing-intelligence-databricks",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "eslint src tests scripts --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "package:databricks": "node scripts/package.mjs",
    "schema:generate": "node scripts/generate-schema.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.md *.json app.yaml",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.md *.json app.yaml"
  },
  "dependencies": {
    "@databricks/sql": "^1.17.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/sql.js": "^1.4.9",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "fflate": "^0.8.3",
    "prettier": "^3.10.1",
    "sql.js": "^1.13.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
