# Local development only. Databricks Apps injects workspace host and OAuth credentials.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
DATABRICKS_CATALOG=your_catalog
DATABRICKS_SCHEMA=your_schema
# Databricks Apps injects authentication automatically. Do not add client secrets.
# For local development, the SDK can use your Databricks CLI login/profile.
